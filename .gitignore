/target

# CA private key — machine-local secret, never commit. Regenerate with the
# openssl commands in the README if you clone fresh.
/crates/lockgate-core/src/ca/ca.key

# runtime log (TUI redirects tracing here)
lockgate.log

# Claude Code's scratch space, including git worktrees it creates under
# .claude/worktrees. Those are checkouts of this same repo — committing them
# would nest the repository inside itself. Ignore everything under .claude
# except versioned skills, which are part of the tool and travel with it.
/.claude/*
!/.claude/skills/

# demo capture — rebuilt by docs/demo/seed.sh, never committed
/docs/demo/.data
/docs/demo/.data.pristine
